#!/bin/bash
# NOOBS ZIVUDP Dashboard – Mobile Optimized (Termius Edition)
# Fixes: IP/location, options 8‑11,19 + compact ASCII art

CONFIG="/etc/zivpn/config.json"
DB="/etc/zivpn/users.db"

# --- Colors (bright, readable on dark Termius backgrounds) ---
C="\e[1;36m"
G="\e[1;32m"
R="\e[1;31m"
Y="\e[1;33m"
M="\e[1;35m"
B="\e[1;34m"
W="\e[1;37m"
NC="\e[0m"
BOLD="\e[1m"

# --- Auto‑install jq ---
if ! command -v jq &>/dev/null; then
    echo -e "${Y}Installing jq...${NC}"
    apt-get install -y jq -qq &>/dev/null
fi

# --- System Info (jq, IP fallback) ---
GEO=$(curl -4 -s --max-time 10 "https://ipapi.co/json/" 2>/dev/null)
if [ -n "$GEO" ]; then
    IP=$(echo "$GEO" | jq -r '.ip // "N/A"')
    CITY=$(echo "$GEO" | jq -r '.city // "Unknown"')
    COUNTRY=$(echo "$GEO" | jq -r '.country_name // "Unknown"')
    ISP=$(echo "$GEO" | jq -r '.org // "Unknown"')
else
    IP="N/A"; CITY="Unknown"; COUNTRY="Unknown"; ISP="Unknown"
fi
[ "$IP" = "N/A" ] && IP=$(curl -4 -s --max-time 5 ifconfig.me 2>/dev/null) && [ -z "$IP" ] && IP="N/A"

OS_INFO=$(grep "PRETTY_NAME" /etc/os-release | cut -d '"' -f 2)

# --- Compact Mobile Banner ---
banner() {
    clear
    DATE_TIME=$(date +"%d/%m/%Y %H:%M")
    echo -e "${C}╔════════════════════════════════════╗${NC}"
    echo -e "${C}║${G}${BOLD}   NOOBS ZIVUDP DASHBOARD         ${C}║${NC}"
    echo -e "${C}╠════════════════════════════════════╣${NC}"
    echo -e "${C}║${Y} Admin:${W} @Ardvak                   ${C}║${NC}"
    echo -e "${C}║${Y} OS   :${W} ${OS_INFO:0:27}   ${C}║${NC}"   # truncated if needed
    echo -e "${C}║${Y} IP   :${W} ${IP}                     ${C}║${NC}"
    echo -e "${C}║${Y} Loc  :${W} ${CITY}, ${COUNTRY:0:20}    ${C}║${NC}"
    echo -e "${C}║${Y} ISP  :${W} ${ISP:0:27}               ${C}║${NC}"
    echo -e "${C}║${Y} Time :${W} ${DATE_TIME}                   ${C}║${NC}"
    echo -e "${C}╚════════════════════════════════════╝${NC}"
    echo ""
}

# --- Goodbye (also compact) ---
goodbye() {
    clear
    echo -e "${C}╔════════════════════════════════════╗${NC}"
    echo -e "${C}║${G}${BOLD}   Thanks for using ZIVUDP!      ${C}║${NC}"
    echo -e "${C}║${Y}      See you again soon 👋      ${C}║${NC}"
    echo -e "${C}║${M}   Admin: @Ardvak                ${C}║${NC}"
    echo -e "${C}╚════════════════════════════════════╝${NC}"
    echo ""
}

# --- Add User ---
add_user() {
    echo -e "\n${Y}--- CREATE NEW USER ---${NC}"
    read -p "User Password: " pass
    read -p "Validity (Days): " days
    read -p "Quota (GB/MB): " quota
    read -p "Device ID (Optional): " devid

    exp=$(date -d "+$days days" +%Y-%m-%d)

    if [ -f "$CONFIG" ]; then
        jq --arg p "$pass" '.auth.config += [$p]' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
    else
        echo -e "${R}Warning: ZIVPN config not found. User saved to DB only.${NC}"
    fi

    echo "$pass|$exp|$quota|${devid:-None}" >> "$DB"
    systemctl restart zivpn 2>/dev/null || echo -e "${Y}Note: zivpn.service not running.${NC}"

    echo -e "\n${C}--- User Created ---${NC}"
    echo -e "${Y}Password :${NC} $pass"
    echo -e "${Y}Expiry   :${NC} $exp ($days Days)"
    echo -e "${Y}Quota    :${NC} $quota"
    echo -e "${Y}Device   :${NC} ${devid:-None}"
}

# --- Trial User ---
trial_user() {
    read -p "Minutes (1-60): " mins
    pass="trial_$(openssl rand -hex 2)"
    if [ -f "$CONFIG" ]; then
        jq --arg p "$pass" '.auth.config += [$p]' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
        systemctl restart zivpn 2>/dev/null
    fi
    echo -e "${G}Trial: ${Y}$pass${G} (expires in $mins mins)${NC}"
    (
        sleep $((mins * 60))
        if [ -f "$CONFIG" ]; then
            jq --arg p "$pass" '.auth.config -= [$p]' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
            systemctl restart zivpn 2>/dev/null
        fi
    ) &
}

# --- Renew / Extend User ---
renew_user() {
    if [ ! -f "$DB" ]; then
        echo -e "${R}User database not found.${NC}"
        return
    fi

    read -p "Password to renew: " target_pass
    if ! grep -q "^${target_pass}|" "$DB"; then
        echo -e "${R}User not found.${NC}"
        return
    fi

    existing_line=$(grep "^${target_pass}|" "$DB")
    IFS='|' read -r pass old_exp quota devid <<< "$existing_line"

    read -p "Days to add: " add_days
    if ! [[ "$add_days" =~ ^[0-9]+$ ]] || [ "$add_days" -le 0 ]; then
        echo -e "${R}Invalid number.${NC}"
        return
    fi

    today=$(date +%Y-%m-%d)
    if [[ "$old_exp" < "$today" ]]; then
        new_exp=$(date -d "+$add_days days" +%Y-%m-%d)
        echo -e "${Y}Was expired. Fresh start from today.${NC}"
    else
        new_exp=$(date -d "$old_exp + $add_days days" +%Y-%m-%d)
    fi

    tmpfile=$(mktemp)
    while IFS= read -r line; do
        [[ "$line" == "$pass|"* ]] && echo "${pass}|${new_exp}|${quota}|${devid}" || echo "$line"
    done < "$DB" > "$tmpfile"
    mv "$tmpfile" "$DB"

    echo -e "${G}Renewed! Old: ${Y}${old_exp}${G} → New: ${Y}${new_exp}${NC} (+$add_days days)"
}

# --- Cleanup Expired ---
cleanup_expired() {
    if [ ! -f "$DB" ]; then
        echo -e "${R}No user DB.${NC}"
        return
    fi

    today=$(date +%Y-%m-%d)
    tmpfile=$(mktemp)
    removed=0

    while IFS='|' read -r pass exp quota devid; do
        if [[ "$exp" < "$today" ]]; then
            [ -f "$CONFIG" ] && jq --arg p "$pass" '.auth.config -= [$p]' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
            ((removed++))
        else
            echo "$pass|$exp|$quota|$devid" >> "$tmpfile"
        fi
    done < "$DB"
    mv "$tmpfile" "$DB"
    systemctl restart zivpn 2>/dev/null
    echo -e "${G}Removed $removed expired user(s).${NC}"
}

# --- Main Menu Loop ---
while true; do
    banner
    # Compact 2‑column menu
    echo -e " ${G} 1)${NC} Start      ${G}11)${NC} BW+Expiry"
    echo -e " ${G} 2)${NC} Stop       ${G}12)${NC} Reset BW"
    echo -e " ${G} 3)${NC} Restart    ${G}13)${NC} Speedtest"
    echo -e " ${G} 4)${NC} Status     ${G}14)${NC} Live Logs"
    echo -e " ${G} 5)${NC} List Users ${G}15)${NC} Backup"
    echo -e " ${G} 6)${NC} Add User   ${G}16)${NC} Restore"
    echo -e " ${G} 7)${NC} Remove     ${G}17)${NC} Port Range"
    echo -e " ${G} 8)${NC} Renew      ${Y}18)${NC} Update"
    echo -e " ${G} 9)${NC} Cleanup    ${G}19)${NC} Conn Limit"
    echo -e " ${G}10)${NC} Stats      ${G}20)${NC} Trial"
    echo -e "${C}────────────────────────────────────${NC}"
    echo -e " ${R}99) UNINSTALL${NC}        ${G} 0) Exit${NC}"
    echo -e "${C}────────────────────────────────────${NC}"
    read -p " Choose: " opt

    case $opt in
        1) systemctl start zivpn 2>/dev/null && echo -e "${G}Started.${NC}" || echo -e "${R}Service not found.${NC}" ;;
        2) systemctl stop zivpn 2>/dev/null && echo -e "${R}Stopped.${NC}" || echo -e "${R}Service not found.${NC}" ;;
        3) systemctl restart zivpn 2>/dev/null && echo -e "${G}Restarted.${NC}" || echo -e "${R}Service not found.${NC}" ;;
        4) systemctl status zivpn 2>/dev/null || echo -e "${R}Service not found.${NC}" ;;
        5)
           if [ -f "$DB" ]; then
               echo -e "\n${C}Pass       Expiry      Quota    Device${NC}"
               column -t -s "|" "$DB"
           else
               echo -e "${R}No user DB.${NC}"
           fi
           ;;
        6) add_user ;;
        7)
           read -p "Password to remove: " pass
           if [ -f "$CONFIG" ]; then
               jq --arg p "$pass" '.auth.config -= [$p]' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
           fi
           [ -f "$DB" ] && sed -i "/^$pass|/d" "$DB"
           systemctl restart zivpn 2>/dev/null
           echo -e "${G}User removed.${NC}"
           ;;
        8) renew_user ;;
        9) cleanup_expired ;;
        10)
            port=$(jq -r '.listen // 8090' "$CONFIG" 2>/dev/null)
            [ -z "$port" ] && port=8090
            conn=$(ss -tn state established "( dport = :$port or sport = :$port )" 2>/dev/null | tail -n +2 | wc -l)
            echo -e "${G}Active on port $port: ${Y}$conn${NC}"
            ;;
        11)
            if [ -f "$DB" ]; then
                echo -e "\n${C}Password        Quota          Expiry${NC}"
                while IFS='|' read -r pass exp quota devid; do
                    printf "%-15s %-14s %s\n" "$pass" "$quota" "$exp"
                done < "$DB"
            else
                echo -e "${R}No user DB.${NC}"
            fi
            ;;
        12) echo -e "${Y}Reset BW: coming soon.${NC}" ;;
        13) echo -e "${Y}Speedtest: coming soon.${NC}" ;;
        14) journalctl -u zivpn -f 2>/dev/null || echo -e "${R}Service not found.${NC}" ;;
        15) echo -e "${Y}Backup: coming soon.${NC}" ;;
        16) echo -e "${Y}Restore: coming soon.${NC}" ;;
        17) echo -e "${Y}Port Range: coming soon.${NC}" ;;
        18)
            echo -e "\n${Y}Updating panel...${NC}"
            wget -qO /usr/local/bin/ziudp https://raw.githubusercontent.com/autobot-sys/NOOBS-UPD/main/ziudp
            chmod +x /usr/local/bin/ziudp
            echo -e "${G}Done. Restarting...${NC}"
            sleep 2
            exec ziudp
            ;;
        19)
            read -p "Max connections: " maxconn
            if [[ "$maxconn" =~ ^[0-9]+$ ]]; then
                if [ -f "$CONFIG" ]; then
                    jq --argjson m "$maxconn" '.max_connections = $m' "$CONFIG" > /tmp/zivpn_tmp.json && mv /tmp/zivpn_tmp.json "$CONFIG"
                    systemctl restart zivpn 2>/dev/null
                    echo -e "${G}Limit set to $maxconn.${NC}"
                else
                    echo -e "${R}Config missing.${NC}"
                fi
            else
                echo -e "${R}Invalid number.${NC}"
            fi
            ;;
        20) trial_user ;;
        99)
           systemctl stop zivpn 2>/dev/null
           rm -rf /etc/zivpn /usr/local/bin/zivpn /usr/local/bin/ziudp
           echo -e "${R}Uninstalled.${NC}"
           exit
           ;;
        0) goodbye; exit ;;
        *) echo -e "${R}Invalid option.${NC}" ;;
    esac
    echo ""
    read -p "Press Enter to continue..."
done
